import re
from collections import Counter
from pathlib import Path

def analyze_logs(file_path):
    # Regex patterns for common log formats (Level: Message)
    # Example: 2023-10-27 10:00:01 ERROR Connection failed
    log_pattern = re.compile(r'(?P<level>INFO|WARNING|ERROR|CRITICAL|DEBUG)', re.IGNORECASE)
    
    stats = Counter()
    common_errors = Counter()
    total_lines = 0

    try:
        with open(file_path, 'r') as file:
            for line in file:
                total_lines += 1
                match = log_pattern.search(line)
                if match:
                    level = match.group('level').upper()
                    stats[level] += 1
                    
                    # If it's an error, grab the message for a detailed report
                    if level in ['ERROR', 'CRITICAL']:
                        message = line.split(level)[-1].strip()
                        common_errors[message] += 1

        generate_report(file_path, total_lines, stats, common_errors)

    except FileNotFoundError:
        print(f"Error: The file '{file_path}' was not found.")

def generate_report(file_path, total, stats, errors):
    print("-" * 30)
    print(f"LOG ANALYSIS REPORT: {Path(file_path).name}")
    print("-" * 30)
    print(f"Total Lines Processed: {total}")
    print("\nLog Level Counts:")
    for level, count in stats.items():
        print(f"- {level}: {count}")

    print("\nTop Critical/Error Messages:")
    for msg, count in errors.most_common(3):
        print(f"- [{count} times]: {msg}")
    
    print("-" * 30)

if __name__ == "__main__":
    log_file = input("Enter the path to the server log file: ").strip()
    analyze_logs(log_file)
